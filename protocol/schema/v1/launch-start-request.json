{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/launch-start-request.json",
  "title": "LaunchStartRequest",
  "description": "An explicit human Start bound to current task and configuration versions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "task_id",
    "expected_task_version",
    "agent_profile_id",
    "workspace_policy_version",
    "project_policy_version",
    "repository_config_version",
    "agent_profile_version",
    "runner_id",
    "checkout_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "idempotency_key": {
      "$ref": "primitives.json#/$defs/IdempotencyKey"
    },
    "task_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "expected_task_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "agent_profile_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "workspace_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "project_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "repository_config_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "agent_profile_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "runner_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "checkout_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "retry_run_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    }
  }
}
