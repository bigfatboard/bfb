{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/checkout-summary.json",
  "title": "CheckoutSummary",
  "description": "Bounded checkout identity summary without local path authority on the wire.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkout_id",
    "runner_id",
    "project_id",
    "repository_identity",
    "status",
    "validated_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "checkout_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "runner_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "project_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "repository_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "workspace_subpath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "type": "string",
      "enum": ["registered", "validated", "stale", "blocked"]
    },
    "validated_at": {
      "$ref": "primitives.json#/$defs/UtcTimestamp"
    }
  }
}
