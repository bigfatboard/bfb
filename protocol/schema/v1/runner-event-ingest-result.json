{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/runner-event-ingest-result.json",
  "title": "RunnerEventIngestResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "high_water_cursor", "dispositions"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "workspace_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "high_water_cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "$ref": "event-disposition.json"
      }
    }
  }
}
