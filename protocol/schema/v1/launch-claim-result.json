{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/launch-claim-result.json",
  "title": "LaunchClaimResult",
  "description": "An immutable claimed specification and snapshot plus its authoritative cloud fence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "specification",
    "snapshot",
    "assignment",
    "fencing_generation",
    "lease_expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "specification": {
      "$ref": "launch-specification.json"
    },
    "snapshot": {
      "$ref": "launch-snapshot.json"
    },
    "assignment": {
      "$ref": "execution-assignment.json"
    },
    "fencing_generation": {
      "$ref": "primitives.json#/$defs/AssignmentGeneration"
    },
    "lease_expires_at": {
      "$ref": "primitives.json#/$defs/UtcTimestamp"
    }
  }
}
