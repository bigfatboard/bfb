{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/agent-artifact-prepare-result.json",
  "title": "AgentArtifactPrepareResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_key",
    "artifact_id",
    "version_id",
    "format",
    "role",
    "content_hash",
    "size",
    "origin",
    "stage",
    "upload",
    "available_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "operation_key": {
      "type": "string",
      "minLength": 70,
      "maxLength": 70,
      "pattern": "^agent:[0-9a-f]{64}$"
    },
    "artifact_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "version_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "format": {
      "type": "string",
      "enum": [
        "markdown",
        "mermaid",
        "diff",
        "svg",
        "png",
        "jpeg",
        "html",
        "log",
        "json"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "review",
        "log"
      ]
    },
    "content_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5242880
    },
    "origin": {
      "$ref": "agent-effect-origin.json"
    },
    "stage": {
      "type": "string",
      "enum": [
        "upload_required",
        "finalize_required",
        "available"
      ]
    },
    "upload": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "grant_id",
            "secret",
            "expires_at"
          ],
          "properties": {
            "origin": {
              "type": "string",
              "minLength": 9,
              "maxLength": 512,
              "pattern": "^https?://[^/?#@\\s]+$"
            },
            "grant_id": {
              "$ref": "primitives.json#/$defs/Ulid"
            },
            "secret": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "expires_at": {
              "$ref": "primitives.json#/$defs/UtcTimestamp"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "available_at": {
      "anyOf": [
        {
          "$ref": "primitives.json#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "const": "upload_required"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "upload": {
            "type": "object"
          },
          "available_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "const": "finalize_required"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "upload": {
            "type": "null"
          },
          "available_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "const": "available"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "upload": {
            "type": "null"
          },
          "available_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "const": "log"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer",
            "maximum": 1048576
          }
        }
      }
    }
  ]
}
