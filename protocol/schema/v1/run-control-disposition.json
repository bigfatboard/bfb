{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/run-control-disposition.json",
  "title": "RunControlDisposition",
  "description": "Explicit locally reconciled disposition of an already-claimed run control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_id",
    "idempotency_key",
    "run_execution_id",
    "assignment_generation",
    "disposition"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "control_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "idempotency_key": {
      "$ref": "primitives.json#/$defs/IdempotencyKey"
    },
    "run_execution_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "assignment_generation": {
      "$ref": "primitives.json#/$defs/AssignmentGeneration"
    },
    "disposition": {
      "type": "string",
      "enum": ["applied", "already_applied", "local_rejected", "delivery_unknown"]
    }
  }
}
