{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/launch-tighten-request.json",
  "title": "LaunchTightenRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "launch_id",
    "run_execution_id",
    "assignment_generation",
    "fencing_generation",
    "config_snapshot_hash",
    "repository_config_hash",
    "document"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "launch_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "run_execution_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "assignment_generation": {
      "$ref": "primitives.json#/$defs/AssignmentGeneration"
    },
    "fencing_generation": {
      "$ref": "primitives.json#/$defs/AssignmentGeneration"
    },
    "config_snapshot_hash": {
      "$ref": "primitives.json#/$defs/Sha256Digest"
    },
    "repository_config_hash": {
      "$ref": "primitives.json#/$defs/Sha256Digest"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_providers": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "primitives.json#/$defs/ProviderName"
          }
        },
        "allow_agent_root_propose": {
          "type": "boolean"
        },
        "allow_pass_to_agent": {
          "type": "boolean"
        },
        "allow_run_overrides": {
          "type": "boolean"
        }
      }
    }
  }
}
