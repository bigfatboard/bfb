{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/launch-claim.json",
  "title": "LaunchClaim",
  "description": "Runner claim request for a pending launch command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "launch_id", "runner_id", "idempotency_key", "claimed_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "launch_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "runner_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "idempotency_key": {
      "$ref": "primitives.json#/$defs/IdempotencyKey"
    },
    "claimed_at": {
      "$ref": "primitives.json#/$defs/UtcTimestamp"
    },
    "device_proof_nonce": {
      "$ref": "primitives.json#/$defs/OpaqueToken"
    }
  }
}
