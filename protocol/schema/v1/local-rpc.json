{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/local-rpc.json",
  "title": "LocalRpcEnvelope",
  "description": "Local Unix-socket RPC envelope between Swift app, CLI, and daemon.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "method", "direction"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.]{0,63}$"
    },
    "direction": {
      "type": "string",
      "enum": ["request", "response", "event"]
    },
    "idempotency_key": {
      "$ref": "primitives.json#/$defs/IdempotencyKey"
    },
    "error": {
      "$ref": "primitives.json#/$defs/TypedError"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 32,
      "properties": {
        "wake_intent_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "terminal_intent_id": { "$ref": "primitives.json#/$defs/TerminalIntentId" },
        "execution_assignment": { "$ref": "local-execution-assignment.json" },
        "local_lock_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "process_group_id": { "type": "integer", "minimum": 2, "maximum": 2147483647 },
        "final_authorization": { "$ref": "final-authorization.json" },
        "app_delivery_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "notification_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "app_session_state": { "type": "string", "enum": ["available", "locked", "login_window"] },
        "app_action": { "type": "string", "enum": ["open_terminal", "notify_attention"] },
        "app_result": {
          "type": "string",
          "enum": [
            "terminal_opened",
            "notification_delivered",
            "notification_denied",
            "consent_denied",
            "session_locked",
            "app_unavailable",
            "app_delivery_unknown",
            "expired_intent",
            "revoked"
          ]
        },
        "workspace_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "runner_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "app_origin": { "type": "string", "maxLength": 256, "pattern": "^https://[^/@?#]+$" },
        "device_label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "enrollment": { "$ref": "runner-local-enrollment.json" },
        "enrollments": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "runner-local-enrollment.json" }
        },
        "enrollment_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[^/@?#]+/runner-enroll#[A-Za-z0-9_-]+$"
        },
        "forgotten": { "type": "boolean" },
        "project_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "checkout_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "label": { "$ref": "checkout-summary.json#/$defs/Label" },
        "repository_identity": { "$ref": "checkout-summary.json#/$defs/RepositoryIdentity" },
        "workspace_subpath": { "$ref": "checkout-summary.json#/$defs/WorkspaceSubpath" },
        "remote_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "local_path": {
          "description": "Local link input only; never a synchronized field or response.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\x00-\\x1f\\x7f]*$"
        },
        "is_default": { "type": "boolean" },
        "unlinked": { "type": "boolean" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 25 },
        "after_checkout_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "next_checkout_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "checkout": { "$ref": "checkout-summary.json" },
        "checkouts": {
          "type": "array",
          "maxItems": 25,
          "items": { "$ref": "checkout-summary.json" }
        },
        "status": { "type": "string", "enum": ["running", "stopping", "installed"] },
        "daemon_pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "started_at": { "$ref": "primitives.json#/$defs/UtcTimestamp" },
        "storage_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "recovery_pending": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "log_entries": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "maxLength": 512 }
        },
        "methods": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_.]{0,63}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["local_lock_id"],
            "properties": { "local_lock_id": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "request" },
          "method": { "enum": ["execution.authorize", "execution.group"] },
          "payload": {
            "type": "object",
            "required": ["terminal_intent_id"],
            "properties": { "terminal_intent_id": {} }
          }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["process_group_id"],
            "properties": { "process_group_id": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "request" },
          "method": { "const": "execution.group" },
          "payload": {
            "type": "object",
            "required": ["terminal_intent_id", "local_lock_id"],
            "properties": { "terminal_intent_id": {}, "local_lock_id": {} }
          }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["final_authorization"],
            "properties": { "final_authorization": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "response" },
          "method": { "const": "execution.authorize" }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["execution_assignment"],
            "properties": { "execution_assignment": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "response" },
          "method": { "const": "execution.register" }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["local_path"],
            "properties": { "local_path": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "request" },
          "method": { "const": "checkout.link" }
        }
      }
    }
  ]
}
