{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/local-rpc.json",
  "title": "LocalRpcEnvelope",
  "description": "Local Unix-socket RPC envelope between Swift app, CLI, and daemon.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "method", "direction"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.]{0,63}$"
    },
    "direction": {
      "type": "string",
      "enum": ["request", "response", "event"]
    },
    "idempotency_key": {
      "$ref": "primitives.json#/$defs/IdempotencyKey"
    },
    "error": {
      "$ref": "primitives.json#/$defs/TypedError"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 32,
      "properties": {
        "workspace_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "runner_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "project_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "checkout_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "label": { "$ref": "checkout-summary.json#/$defs/Label" },
        "repository_identity": { "$ref": "checkout-summary.json#/$defs/RepositoryIdentity" },
        "workspace_subpath": { "$ref": "checkout-summary.json#/$defs/WorkspaceSubpath" },
        "remote_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "local_path": {
          "description": "Local link input only; never a synchronized field or response.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\x00-\\x1f\\x7f]*$"
        },
        "is_default": { "type": "boolean" },
        "unlinked": { "type": "boolean" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 25 },
        "after_checkout_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "next_checkout_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "checkout": { "$ref": "checkout-summary.json" },
        "checkouts": {
          "type": "array",
          "maxItems": 25,
          "items": { "$ref": "checkout-summary.json" }
        },
        "status": { "type": "string", "enum": ["running", "stopping", "installed"] },
        "daemon_pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "started_at": { "$ref": "primitives.json#/$defs/UtcTimestamp" },
        "storage_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "recovery_pending": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "log_entries": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "maxLength": 512 }
        },
        "methods": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_.]{0,63}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["local_path"],
            "properties": { "local_path": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "request" },
          "method": { "const": "checkout.link" }
        }
      }
    }
  ]
}
