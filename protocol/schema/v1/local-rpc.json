{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/local-rpc.json",
  "title": "LocalRpcEnvelope",
  "description": "Local Unix-socket RPC envelope between Swift app, CLI, and daemon.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "method", "direction"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.]{0,63}$"
    },
    "direction": {
      "type": "string",
      "enum": ["request", "response", "event"]
    },
    "idempotency_key": {
      "$ref": "primitives.json#/$defs/IdempotencyKey"
    },
    "error": {
      "$ref": "primitives.json#/$defs/TypedError"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 32,
      "properties": {
        "wake_intent_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "terminal_intent_id": { "$ref": "primitives.json#/$defs/TerminalIntentId" },
        "execution_assignment": { "$ref": "local-execution-assignment.json" },
        "execution_control": { "$ref": "local-execution-control.json" },
        "execution_focus": { "$ref": "local-execution-focus.json" },
        "control_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "control_disposition": {
          "type": "string",
          "enum": ["applied", "local_rejected", "delivery_unknown"]
        },
        "local_lock_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "process_group_id": { "type": "integer", "minimum": 2, "maximum": 2147483647 },
        "final_authorization": { "$ref": "final-authorization.json" },
        "app_delivery_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "notification_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "app_session_state": { "type": "string", "enum": ["available", "locked", "login_window"] },
        "app_action": {
          "type": "string",
          "enum": ["open_terminal", "focus_terminal", "notify_attention"]
        },
        "app_result": {
          "type": "string",
          "enum": [
            "terminal_opened",
            "terminal_focused",
            "notification_delivered",
            "notification_denied",
            "consent_denied",
            "session_locked",
            "app_unavailable",
            "app_delivery_unknown",
            "expired_intent",
            "revoked"
          ]
        },
        "workspace_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "runner_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "app_origin": { "type": "string", "maxLength": 256, "pattern": "^https://[^/@?#]+$" },
        "device_label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "enrollment": { "$ref": "runner-local-enrollment.json" },
        "enrollments": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "runner-local-enrollment.json" }
        },
        "enrollment_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[^/@?#]+/runner-enroll#[A-Za-z0-9_-]+$"
        },
        "forgotten": { "type": "boolean" },
        "project_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "checkout_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "label": { "$ref": "checkout-summary.json#/$defs/Label" },
        "repository_identity": { "$ref": "checkout-summary.json#/$defs/RepositoryIdentity" },
        "workspace_subpath": { "$ref": "checkout-summary.json#/$defs/WorkspaceSubpath" },
        "remote_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "local_path": {
          "description": "Local link input only; never a synchronized field or response.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\x00-\\x1f\\x7f]*$"
        },
        "is_default": { "type": "boolean" },
        "unlinked": { "type": "boolean" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 25 },
        "after_checkout_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "next_checkout_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "checkout": { "$ref": "checkout-summary.json" },
        "checkouts": {
          "type": "array",
          "maxItems": 25,
          "items": { "$ref": "checkout-summary.json" }
        },
        "status": { "type": "string", "enum": ["running", "stopping", "installed"] },
        "daemon_pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "started_at": { "$ref": "primitives.json#/$defs/UtcTimestamp" },
        "storage_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "recovery_pending": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "log_entries": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "maxLength": 512 }
        },
        "methods": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_.]{0,63}$"
          }
        },
        "control_url": {
          "description": "Artifact publication input only; Control Worker origin.",
          "type": "string",
          "maxLength": 256,
          "pattern": "^https?://[^/@?#]+$"
        },
        "artifacts_url": {
          "description": "Artifact publication input only; Artifact Worker origin.",
          "type": "string",
          "maxLength": 256,
          "pattern": "^https?://[^/@?#]+$"
        },
        "artifact_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "run_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "artifact_format": {
          "type": "string",
          "enum": ["markdown", "mermaid", "diff", "svg", "png", "jpeg", "html", "log", "json"]
        },
        "artifact_role": {
          "type": "string",
          "enum": ["review", "log"]
        },
        "artifact_path": {
          "description": "Local publication input only; never a synchronized field or response.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\x00-\\x1f\\x7f]*$"
        },
        "artifact_cookie": {
          "description": "Local credential input only; never logged or synchronized.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "artifact_bearer": {
          "description": "Local credential input only; never logged or synchronized.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version_id": { "$ref": "primitives.json#/$defs/Ulid" },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "r2_key": {
          "description": "Server-derived artifact response only; never a caller input.",
          "type": "string",
          "maxLength": 512,
          "pattern": "^workspaces/[^\\x00-\\x1f\\x7f]+$"
        },
        "artifact_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "method": { "const": "execution.recover" } } },
      "then": { "properties": { "direction": { "enum": ["request", "response"] } } }
    },
    {
      "if": {
        "properties": {
          "method": { "const": "execution.recover" },
          "direction": { "const": "request" }
        }
      },
      "then": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["terminal_intent_id"],
            "properties": { "terminal_intent_id": {} }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": { "const": "execution.recover" },
          "direction": { "const": "response" }
        }
      },
      "then": { "properties": { "payload": { "type": "object", "maxProperties": 0 } } }
    },
    {
      "if": {
        "properties": {
          "method": { "const": "app.focus_check" },
          "direction": { "const": "request" }
        }
      },
      "then": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["app_delivery_id"],
            "properties": { "app_delivery_id": {} }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": { "const": "app.focus_check" },
          "direction": { "const": "response" }
        }
      },
      "then": { "properties": { "payload": { "type": "object", "maxProperties": 0 } } }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["execution_focus"],
            "properties": { "execution_focus": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "response" },
          "method": { "const": "app.poll" },
          "payload": {
            "type": "object",
            "required": ["app_delivery_id", "app_action"],
            "properties": { "app_delivery_id": {}, "app_action": { "const": "focus_terminal" } }
          }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["execution_control"],
            "properties": { "execution_control": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "response" },
          "method": { "const": "execution.control" }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "anyOf": [
              { "required": ["control_id"], "properties": { "control_id": {} } },
              { "required": ["control_disposition"], "properties": { "control_disposition": {} } }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "request" },
          "method": { "const": "execution.control_result" },
          "payload": {
            "type": "object",
            "required": ["terminal_intent_id", "control_id", "control_disposition"],
            "properties": { "terminal_intent_id": {}, "control_id": {}, "control_disposition": {} }
          }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["local_lock_id"],
            "properties": { "local_lock_id": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "request" },
          "method": { "enum": ["execution.authorize", "execution.group"] },
          "payload": {
            "type": "object",
            "required": ["terminal_intent_id"],
            "properties": { "terminal_intent_id": {} }
          }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["process_group_id"],
            "properties": { "process_group_id": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "request" },
          "method": { "const": "execution.group" },
          "payload": {
            "type": "object",
            "required": ["terminal_intent_id", "local_lock_id"],
            "properties": { "terminal_intent_id": {}, "local_lock_id": {} }
          }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["final_authorization"],
            "properties": { "final_authorization": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "response" },
          "method": { "const": "execution.authorize" }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["execution_assignment"],
            "properties": { "execution_assignment": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "response" },
          "method": { "const": "execution.register" }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["local_path"],
            "properties": { "local_path": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "request" },
          "method": { "const": "checkout.link" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": { "const": "artifact.publish" },
          "direction": { "const": "request" }
        }
      },
      "then": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control_url",
              "artifacts_url",
              "workspace_id",
              "artifact_format",
              "artifact_role",
              "artifact_path"
            ],
            "properties": {
              "control_url": {},
              "artifacts_url": {},
              "workspace_id": {},
              "artifact_id": {},
              "run_id": {},
              "artifact_format": {},
              "artifact_role": {},
              "artifact_path": {},
              "artifact_cookie": {},
              "artifact_bearer": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["version_id", "content_hash"],
            "properties": { "version_id": {}, "content_hash": {} }
          }
        }
      },
      "then": {
        "properties": {
          "direction": { "const": "response" },
          "method": { "const": "artifact.publish" },
          "payload": {
            "type": "object",
            "required": ["version_id", "content_hash", "artifact_size"],
            "properties": { "version_id": {}, "content_hash": {}, "artifact_size": {} }
          }
        }
      }
    }
  ]
}
