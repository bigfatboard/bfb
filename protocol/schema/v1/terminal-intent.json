{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/terminal-intent.json",
  "title": "TerminalIntent",
  "description": "Daemon-local Terminal.app bootstrap intent. Distinct from cloud wake; never carries shell or task data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_kind",
    "local_intent_id",
    "launch_id",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "intent_kind": {
      "type": "string",
      "const": "terminal_local"
    },
    "local_intent_id": {
      "$ref": "primitives.json#/$defs/TerminalIntentId"
    },
    "launch_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "created_at": {
      "$ref": "primitives.json#/$defs/UtcTimestamp"
    },
    "expires_at": {
      "$ref": "primitives.json#/$defs/UtcTimestamp"
    }
  }
}
