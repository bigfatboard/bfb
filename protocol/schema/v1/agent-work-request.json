{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/agent-work-request.json",
  "title": "AgentWorkRequest",
  "description": "A01 fixed work action reference; the server derives every domain boundary from the assignment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_execution_id", "assignment_generation", "request_id"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_execution_id": { "$ref": "primitives.json#/$defs/Ulid" },
    "assignment_generation": { "$ref": "primitives.json#/$defs/AssignmentGeneration" },
    "request_id": { "$ref": "primitives.json#/$defs/IdempotencyKey" }
  }
}
