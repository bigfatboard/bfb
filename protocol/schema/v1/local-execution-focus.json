{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/local-execution-focus.json",
  "title": "LocalExecutionFocus",
  "description": "Local-only exact-tab routing from a freshly verified supervisor. The app rechecks the pending delivery before each effect; no cloud path, PID or shell command is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "terminal_intent_id",
    "control_id",
    "run_execution_id",
    "assignment_generation",
    "tty",
    "authorized_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "terminal_intent_id": { "$ref": "primitives.json#/$defs/TerminalIntentId" },
    "control_id": { "$ref": "primitives.json#/$defs/Ulid" },
    "run_execution_id": { "$ref": "primitives.json#/$defs/Ulid" },
    "assignment_generation": { "$ref": "primitives.json#/$defs/AssignmentGeneration" },
    "tty": { "type": "string", "maxLength": 15, "pattern": "^/dev/ttys[0-9]{3,6}$" },
    "authorized_at": { "$ref": "primitives.json#/$defs/UtcTimestamp" },
    "expires_at": { "$ref": "primitives.json#/$defs/UtcTimestamp" }
  }
}
