{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/agent-artifact-result.json",
  "title": "AgentArtifactResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_key",
    "artifact_id",
    "version_id",
    "format",
    "role",
    "content_hash",
    "size",
    "origin",
    "state",
    "available_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "operation_key": {
      "type": "string",
      "minLength": 70,
      "maxLength": 70,
      "pattern": "^agent:[0-9a-f]{64}$"
    },
    "artifact_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "version_id": {
      "$ref": "primitives.json#/$defs/Ulid"
    },
    "format": {
      "type": "string",
      "enum": [
        "markdown",
        "mermaid",
        "diff",
        "svg",
        "png",
        "jpeg",
        "html",
        "log",
        "json"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "review",
        "log"
      ]
    },
    "content_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5242880
    },
    "origin": {
      "$ref": "agent-effect-origin.json"
    },
    "state": {
      "type": "string",
      "const": "available"
    },
    "available_at": {
      "$ref": "primitives.json#/$defs/UtcTimestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "const": "log"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer",
            "maximum": 1048576
          }
        }
      }
    }
  ]
}
