{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qdis/bfb/protocol/schema/v1/agent-result-request.json",
  "title": "AgentResultRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["reference", "binding", "summary"],
  "properties": {
    "reference": {
      "$ref": "agent-work-request.json"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "limitations": {
      "type": "string",
      "minLength": 0,
      "maxLength": 2048
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "hash": {
            "$ref": "primitives.json#/$defs/Sha256Digest"
          }
        }
      }
    },
    "git_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "git_commit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "git_dirty": {
      "type": "boolean"
    },
    "binding": {
      "$ref": "agent-session-reference.json"
    }
  }
}
